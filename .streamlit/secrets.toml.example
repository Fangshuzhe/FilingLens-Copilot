LLM_BASE_URL = "https://openrouter.ai/api/v1"
LLM_API_KEY = "replace-with-your-openrouter-key"
LLM_MODEL = "baidu/ernie-5.5-flash-preview:free"
LLM_TIMEOUT_SECONDS = "120"

# Streamlit Community Cloud uses an ephemeral filesystem.
# Conversation and uploaded report data may be lost after an instance restart.
FILINGLENS_DATA_DIR = "/tmp/filinglens"
